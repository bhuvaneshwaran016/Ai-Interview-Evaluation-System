# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to GitHub.

# PostgreSQL connection string (used by main.py and most scripts)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/interview_db

# Plain DB password (used by the standalone utility scripts:
# kill_pg_locks.py, migrate_db.py, migrate_interview_video.py,
# update_expressions.py, reset_failed_expressions.py, export_transcriptions.py,
# reprocess_videos.py, reprocess_all_videos.py, reprocess_improved.py,
# simple_transcribe_workflow.py, upload_server.py)
DB_PASSWORD=YOUR_PASSWORD

# Cloudinary (used for storing interview videos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
